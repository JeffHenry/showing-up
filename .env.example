# Copy to .env.local (git-ignored) and adjust. Never commit real secrets.
#
# The values below point at the LOCAL Supabase stack (`npm run db:start`). They are the CLI's
# shared development defaults, not credentials; `npm run db:status` prints them if they differ.
# Hosted environments get their values from Vercel (Preview -> staging, Production -> production).

# --- Client (bundled into the browser; data is protected by RLS) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_SENTRY_DSN=

# --- Server only (Vercel functions). Never prefix these with VITE_ ---
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
