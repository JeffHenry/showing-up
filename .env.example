# Copy to .env.local and fill in values. Never commit real values.

# --- Client (bundled into the browser; data is protected by RLS) ---
# Local values: run `npm run db:status` after `npm run db:start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# --- Server only (Vercel functions). Never prefix these with VITE_ ---
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
